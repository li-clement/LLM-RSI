{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract": {
    "id": "DS-TRAINMIX",
    "kind": "dataset",
    "version": "1.0.0",
    "status": "active",
    "owner": "DATA",
    "consumers": [
      "MODEL"
    ],
    "compatibility": "backward",
    "steward": "@dataset-steward"
  },
  "x-sla": {
    "cadence": "weekly",
    "freshness_days": 7,
    "min_count": 20000
  },
  "x-quality": [
    {
      "assert": "pairwise_dedup_rate >= 0.995",
      "action": "block"
    },
    {
      "assert": "eval_leak_count == 0",
      "action": "block",
      "note": "训练-评测污染审计，P3 机器执行；见 PIT-001 与 ADR-0001"
    },
    {
      "assert": "synthetic_share <= 0.35",
      "action": "block",
      "note": "合成样本占比上限，E-001 预算"
    },
    {
      "assert": "lineage_complete_rate == 1.0",
      "action": "block",
      "note": "每条样本可回溯到 episode_id 或声明来源"
    },
    {
      "assert": "judge_version_in_mix >= 2",
      "action": "warn",
      "note": "单一判分口径垄断 mix 时提示口径依赖风险"
    }
  ],
  "title": "训练集样本记录（challenger 训练 mix）",
  "description": "DATA 每周组装、MODEL 训练消费的记录契约。mix 口径变更 = 破坏性变更；字段只增不减（可选）。",
  "type": "object",
  "required": [
    "sample_id",
    "source",
    "task_id",
    "input",
    "output",
    "reward_verdict",
    "lineage"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "全局唯一，含批次前缀"
    },
    "source": {
      "type": "string",
      "enum": [
        "human",
        "rollout",
        "distilled",
        "synthetic"
      ],
      "description": "rollout=真实轨迹；distilled=由轨迹改写；synthetic=无轨迹原型"
    },
    "task_id": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "string"
    },
    "reward_verdict": {
      "type": "object",
      "required": [
        "label",
        "judge_version"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "win",
            "lose",
            "tie",
            "unknown"
          ]
        },
        "judge_version": {
          "type": "string",
          "description": "与 TRJ-ROLLOUT 的 terminal_verdict.judge_version 同口径登记"
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "origin",
        "created_at"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "description": "episode_id / 源数据集版本 / 生成器版本三选一，可回溯"
        },
        "steps_hash": {
          "type": "string",
          "description": "source=rollout 时必填（TRJ-ROLLOUT.steps_digest.steps_hash）"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "mix_group": {
      "type": "string",
      "description": "配比组标识；组间口径差异见 CR 记录"
    },
    "license": {
      "type": "string",
      "enum": [
        "internal-derived"
      ],
      "description": "新增枚举值 = 破坏性变更（PIT-001）"
    }
  }
}
