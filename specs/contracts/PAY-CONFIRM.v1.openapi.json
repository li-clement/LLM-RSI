{
  "openapi": "3.0.3",
  "x-contract": {
    "id": "PAY-CONFIRM",
    "kind": "api",
    "version": "1.0.0",
    "status": "active",
    "owner": "PAY",
    "consumers": ["MID"],
    "compatibility": "backward",
    "steward": "@pay-steward"
  },
  "info": {
    "title": "支付单确认查询 API",
    "version": "1.0.0",
    "description": "MID 凭 paymentId 向 PAY 查询支付终态。超时与重试策略遵循 ADR-0001。"
  },
  "paths": {
    "/payments/{paymentId}/confirmation": {
      "get": {
        "operationId": "getPaymentConfirmation",
        "parameters": [
          { "name": "paymentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "支付单存在（不保证成功，成功与否看 status）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentConfirmation" }
              }
            }
          },
          "404": { "description": "支付单不存在" },
          "408": { "description": "处理中，消费者应按 ADR-0001 退避重试" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentConfirmation": {
        "type": "object",
        "required": ["paymentId", "status", "confirmedAt"],
        "properties": {
          "paymentId": { "type": "string" },
          "status": { "type": "string", "enum": ["succeeded", "failed", "pending"] },
          "confirmedAt": { "type": "string", "format": "date-time" },
          "channelTrace": { "type": "string", "description": "渠道侧流水号，用于对账，可选新增字段（非破坏性）" }
        }
      }
    }
  }
}
