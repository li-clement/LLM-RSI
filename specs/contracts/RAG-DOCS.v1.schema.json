{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract": {
    "id": "RAG-DOCS",
    "kind": "dataset",
    "version": "1.0.0",
    "status": "active",
    "owner": "DATA",
    "consumers": ["AGENT"],
    "compatibility": "backward",
    "steward": "@dataset-steward"
  },
  "x-sla": {
    "cadence": "daily",
    "freshness_hours": 24,
    "min_count": 500000
  },
  "x-quality": [
    { "assert": "index_freshness_hours <= 24", "action": "block", "note": "文档更新到可检索的延迟上限（RAG 的第一性 SLA）" },
    { "assert": "embedding_version_consistent == 1.0", "action": "block", "note": "同一索引内 embedding 模型版本必须一致；换版 = 全量重建走 CR（防版本混用致召回假性下降）" },
    { "assert": "chunk_orphan_rate <= 0.01", "action": "warn", "note": "chunk 无法回链源文档的占比" },
    { "assert": "pii_stripped_rate == 1.0", "action": "block", "note": "知识库不含未脱敏个人信息" },
    { "assert": "dupe_doc_rate <= 0.05", "action": "warn" },
    { "assert": "source_registered_rate == 1.0", "action": "block", "note": "文档必须有可信源（可引用、可撤回）" }
  ],
  "title": "RAG 知识库与索引契约",
  "description": "DATA 维护、AGENT 检索消费的文档/chunk/索引契约。embedding 版本与 chunk 策略属口径——换 embedding 模型或切块规则 = 破坏性变更，重建全量索引并过 RAG-RETRIEVE 评测。",
  "type": "object",
  "required": ["doc_id", "source_id", "chunks", "indexed_at"],
  "properties": {
    "doc_id": { "type": "string" },
    "source_id": { "type": "string", "description": "可信源标识，回链 SRC-INGEST 或外部权威源" },
    "title": { "type": "string" },
    "lang": { "type": "string" },
    "valid_through": { "type": "string", "format": "date", "description": "知识有效期——过期自动降权（防喂过期事实）" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "text_ref", "embedding"],
        "properties": {
          "chunk_id": { "type": "string" },
          "text_ref": { "type": "string", "description": "内容寻址" },
          "embedding": {
            "type": "object",
            "required": ["model_version", "dim"],
            "properties": {
              "model_version": { "type": "string", "description": "embedding 模型登记版本（一致性断言锚点）" },
              "dim": { "type": "integer" }
            }
          }
        }
      }
    },
    "chunking_policy": { "type": "string", "description": "切块策略版本：size/overlap/split 规则——口径项" },
    "indexed_at": { "type": "string", "format": "date-time" },
    "lineage": { "type": "object", "properties": { "origin": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" } } }
  }
}
