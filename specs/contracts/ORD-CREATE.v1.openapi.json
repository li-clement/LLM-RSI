{
  "openapi": "3.0.3",
  "x-contract": {
    "id": "ORD-CREATE",
    "kind": "api",
    "version": "1.0.0",
    "status": "active",
    "owner": "MID",
    "consumers": ["FRONT"],
    "compatibility": "backward",
    "steward": "@trade-steward-mid"
  },
  "info": {
    "title": "订单创建 API",
    "version": "1.0.0",
    "description": "跨 BU 契约。幂等键语义见 ADR-0001 与 PAT-001；实现与测试以本文件为唯一事实源。"
  },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "maxLength": 64 },
            "description": "客户端生成的幂等键；重复提交返回首次结果，见 PAT-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "订单已创建",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderCreated" }
              }
            }
          },
          "409": { "description": "幂等键冲突且请求体与首次不一致" },
          "422": { "description": "业务校验失败，error.code 见 OrderError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderCreateRequest": {
        "type": "object",
        "required": ["channel", "buyerId", "items", "amountCents"],
        "properties": {
          "channel": { "type": "string", "enum": ["app", "web", "mini"], "description": "新增枚举值视为非破坏性变更；删除/收窄视为破坏性变更（PIT-001）" },
          "buyerId": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["skuId", "qty"],
              "properties": {
                "skuId": { "type": "string" },
                "qty": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "amountCents": { "type": "integer", "minimum": 1, "description": "金额一律以最小货币单位整数传输，见 CONTEXT.md" }
        }
      },
      "OrderCreated": {
        "type": "object",
        "required": ["orderId", "status"],
        "properties": {
          "orderId": { "type": "string" },
          "status": { "type": "string", "enum": ["created"] },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "OrderError": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
